      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape-gw_pago_aprobado" bpmnElement="gw_pago_aprobado" isMarkerVisible="true">
        <omgdc:Bounds x="815" y="115" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape-task_notificar_rechazo" bpmnElement="task_notificar_rechazo">
