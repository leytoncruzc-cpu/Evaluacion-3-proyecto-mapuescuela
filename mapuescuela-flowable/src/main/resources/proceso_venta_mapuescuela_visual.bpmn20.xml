      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape-task_actualizar_inventario" bpmnElement="task_actualizar_inventario">
        <omgdc:Bounds x="950" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape-task_preparar_pedido" bpmnElement="task_preparar_pedido">
        <omgdc:Bounds x="1110" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape-gw_modalidad" bpmnElement="gw_modalidad" isMarkerVisible="true">
        <omgdc:Bounds x="1295" y="115" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape-task_listo_retiro" bpmnElement="task_listo_retiro">
        <omgdc:Bounds x="1430" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape-task_registrar_retiro" bpmnElement="task_registrar_retiro">
        <omgdc:Bounds x="1590" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape-end_finalizado_retiro" bpmnElement="end_finalizado_retiro">
        <omgdc:Bounds x="1782" y="122" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape-task_registrar_despacho" bpmnElement="task_registrar_despacho">
        <omgdc:Bounds x="1430" y="240" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape-task_confirmar_entrega" bpmnElement="task_confirmar_entrega">
        <omgdc:Bounds x="1590" y="240" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape-end_finalizado_despacho" bpmnElement="end_finalizado_despacho">
        <omgdc:Bounds x="1782" y="262" width="36" height="36"/>
      </bpmndi:BPMNShape>

