<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://mapuescuela.org/bpmn/asis">

  <collaboration id="collab_venta_asis">
    <participant id="pool_venta_asis" name="Mapuescuela - Proceso de Venta (AS-IS, manual)" processRef="proceso_venta_asis"/>
    <participant id="pool_cliente_asis" name="Cliente" processRef="proceso_cliente_asis"/>

    <messageFlow id="mf1" name="Publicacion visible" sourceRef="task_publicar_producto" targetRef="task_ver_publicacion"/>
    <messageFlow id="mf2" name="Contacto por WhatsApp" sourceRef="task_contactar_voluntario" targetRef="task_confirmar_disponibilidad"/>
    <messageFlow id="mf3" name="Datos bancarios" sourceRef="task_informar_datos_bancarios" targetRef="task_transferir_dinero"/>
    <messageFlow id="mf4" name="Comprobante de pago" sourceRef="task_enviar_comprobante" targetRef="task_revisar_comprobante_manual"/>
    <messageFlow id="mf5" name="Aviso de rechazo" sourceRef="task_avisar_rechazo" targetRef="msg_espera_resultado"/>
    <messageFlow id="mf6" name="Confirmacion de pago aprobado" sourceRef="task_anotar_venta" targetRef="msg_espera_resultado"/>
    <messageFlow id="mf7" name="Coordinacion de retiro/despacho" sourceRef="task_coordinar_entrega_voluntario" targetRef="task_coordinar_entrega_cliente"/>
  </collaboration>

  <!-- PROCESO DE LA ORGANIZACION (Voluntario Mapuescuela) -->
  <process id="proceso_venta_asis" name="Proceso de Venta - Situacion Actual (Manual)" isExecutable="false">

    <startEvent id="start_publicar" name="Producto disponible para vender"/>
    <manualTask id="task_publicar_producto" name="Publicar producto (Instagram / boca a boca)"/>
    <sequenceFlow id="f1" sourceRef="start_publicar" targetRef="task_publicar_producto"/>

    <manualTask id="task_confirmar_disponibilidad" name="Confirmar disponibilidad manualmente"/>

    <manualTask id="task_informar_datos_bancarios" name="Informar datos bancarios por mensaje"/>
    <sequenceFlow id="f5" sourceRef="task_confirmar_disponibilidad" targetRef="task_informar_datos_bancarios"/>

    <manualTask id="task_revisar_comprobante_manual" name="Revisar comprobante manualmente"/>

    <exclusiveGateway id="gw_pago_valido" name="Pago valido?"/>
    <sequenceFlow id="f9" sourceRef="task_revisar_comprobante_manual" targetRef="gw_pago_valido"/>

    <manualTask id="task_avisar_rechazo" name="Avisar rechazo por mensaje"/>
    <sequenceFlow id="f10" name="No" sourceRef="gw_pago_valido" targetRef="task_avisar_rechazo"/>
    <endEvent id="end_venta_rechazada" name="Venta no concretada"/>
    <sequenceFlow id="f11" sourceRef="task_avisar_rechazo" targetRef="end_venta_rechazada"/>

    <manualTask id="task_anotar_venta" name="Anotar venta (cuaderno / planilla Excel)"/>
    <sequenceFlow id="f12" name="Si" sourceRef="gw_pago_valido" targetRef="task_anotar_venta"/>

    <manualTask id="task_coordinar_entrega_voluntario" name="Coordinar retiro o despacho por mensaje"/>
    <sequenceFlow id="f13" sourceRef="task_anotar_venta" targetRef="task_coordinar_entrega_voluntario"/>

    <manualTask id="task_registrar_entrega_manual" name="Registrar entrega manualmente (si se recuerda)"/>
    <sequenceFlow id="f15" sourceRef="task_coordinar_entrega_voluntario" targetRef="task_registrar_entrega_manual"/>

    <endEvent id="end_venta_finalizada" name="Venta finalizada"/>
    <sequenceFlow id="f16" sourceRef="task_registrar_entrega_manual" targetRef="end_venta_finalizada"/>

  </process>

  <!-- PROCESO DEL CLIENTE (entidad externa a la organizacion) -->
  <process id="proceso_cliente_asis" name="Proceso del Cliente (AS-IS, manual)" isExecutable="false">

    <startEvent id="start_cliente" name="Interesado en el producto"/>
    <manualTask id="task_ver_publicacion" name="Ver publicacion del producto"/>
    <sequenceFlow id="c1" sourceRef="start_cliente" targetRef="task_ver_publicacion"/>

    <manualTask id="task_contactar_voluntario" name="Contactar a un voluntario (WhatsApp/mensaje)"/>
    <sequenceFlow id="c2" sourceRef="task_ver_publicacion" targetRef="task_contactar_voluntario"/>

    <manualTask id="task_transferir_dinero" name="Realizar transferencia bancaria"/>
    <sequenceFlow id="c3" sourceRef="task_contactar_voluntario" targetRef="task_transferir_dinero"/>

    <manualTask id="task_enviar_comprobante" name="Enviar comprobante (foto por WhatsApp)"/>
    <sequenceFlow id="c4" sourceRef="task_transferir_dinero" targetRef="task_enviar_comprobante"/>

    <intermediateCatchEvent id="msg_espera_resultado" name="Espera resultado de la revision">
      <messageEventDefinition/>
    </intermediateCatchEvent>
    <sequenceFlow id="c5" sourceRef="task_enviar_comprobante" targetRef="msg_espera_resultado"/>

    <exclusiveGateway id="gw_resultado_cliente" name="Pago aprobado?"/>
    <sequenceFlow id="c6" sourceRef="msg_espera_resultado" targetRef="gw_resultado_cliente"/>

    <endEvent id="end_cliente_rechazado" name="Compra no concretada"/>
    <sequenceFlow id="c7" name="No" sourceRef="gw_resultado_cliente" targetRef="end_cliente_rechazado"/>

    <manualTask id="task_coordinar_entrega_cliente" name="Acordar dia/hora de retiro o despacho"/>
    <sequenceFlow id="c8" name="Si" sourceRef="gw_resultado_cliente" targetRef="task_coordinar_entrega_cliente"/>

    <endEvent id="end_cliente_finalizado" name="Compra finalizada"/>
    <sequenceFlow id="c9" sourceRef="task_coordinar_entrega_cliente" targetRef="end_cliente_finalizado"/>

  </process>

